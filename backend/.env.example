# Пример конфигурации бэкенда. Скопируйте в .env и заполните своими значениями.
# Никогда не коммитьте реальный .env с секретами.

# --- HTTP ---
APP_ADDR=:8080
APP_ENV=development

# --- База данных ---
# sqlite (по умолчанию, без внешних зависимостей) или postgres
DB_DRIVER=sqlite
# Для SQLite: каталог файла mindia.db
DATA_DIR=./data
# Для Postgres раскомментируйте и укажите строку подключения:
# DATABASE_URL=postgres://mindia:mindia@localhost:5432/mindia?sslmode=disable

# --- Аутентификация ---
# Обязателен в production, минимум 16 символов. В dev есть небезопасный дефолт.
JWT_SECRET=change-me-demo-secret-please-32chars
JWT_TTL=12h

# --- CORS ---
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173

# --- AI-ассистент ---
# Пока не включён, ассистент работает в детерминированном офлайн-режиме.
AI_ENABLED=true
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=
AI_MODEL=deepseek-v4.1
# Общий лимит токенов (вход+выход) для демо-режима; после исчерпания
# ассистент отвечает «Демо-режим ассистента закончился».
AI_BUDGET_TOKENS=500000
AI_MAX_TOOL_CALLS=6
AI_TIMEOUT=45s
